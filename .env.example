# ==========================================
# VulnForge Environment Configuration
# ==========================================

# ------------------------------------------
# Application Security
# ------------------------------------------
# SECRET_KEY is used by the FastAPI backend to sign JWT tokens.
# WARNING: IN PRODUCTION, THIS MUST BE A LONG, RANDOMLY GENERATED STRING.
# You can generate one using: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SCRIPTS_LONG_ENOUGH_FOR_TESTING

# ------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------
# The PostgreSQL container stores all Targets, Assets, and Vulnerabilities.
# POSTGRES_PASSWORD must be changed in production.
POSTGRES_USER=vulnforge_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vulnforge

# These are used by the FastAPI backend to connect to the DB container.
# In docker-compose, POSTGRES_HOST should match the service name ('db').
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------
# Redis Configuration (Celery / Background Tasks)
# ------------------------------------------
# Redis handles caching and async task queues for long-running scans.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------
# ALLOWED_ORIGINS tells the backend which domains are allowed to make API requests.
# Format as a JSON array of strings. 
# For Development: ["http://localhost:3000", "http://localhost:5173"]
# For Production:  ["http://localhost", "https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# (Frontend Only) The base URL where the Vite React app expects to find the API.
# In development: http://localhost:8000/api/v1
# In production via Nginx proxy: /api/v1
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------
# RAG Knowledge Base (writeup embeddings)
# ------------------------------------------
# Voyage AI API key. If unset, a local deterministic FAKE embedder is used — the
# pipeline works but results are NOT semantically meaningful. Set this to enable
# real semantic retrieval. Commit to one model/dimension; changing them requires
# re-embedding the whole corpus.
VOYAGE_API_KEY=
# Optional fallback key — used ONLY after the primary key's free-token quota is
# exhausted (not for transient rate limits). Note: pooling free accounts to get
# around per-account limits may violate the provider's ToS.
VOYAGE_API_KEY_FALLBACK=
# RAG_EMBEDDING_MODEL=voyage-3.5-lite
# RAG_EMBEDDING_DIM=1024
# Enable the scheduled (daily) writeup ingestion beat task.
RAG_INGEST_ENABLED=false
# Optional: HackerOne API token for authenticated Hacktivity access.
# HACKERONE_API_TOKEN=
