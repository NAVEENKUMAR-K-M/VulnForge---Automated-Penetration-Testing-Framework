# ──────────────────────────────────────────────────────────────────────────────
# VulnForge — Environment Variables Template
# Copy to .env and populate all values. Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=VulnForge
APP_VERSION=0.1.0
APP_ENV=development
# development | staging | production
DEBUG=true
LOG_LEVEL=INFO
# JSON | CONSOLE
LOG_FORMAT=CONSOLE

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python scripts/generate_secret.py
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SCRIPTS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vulnforge
POSTGRES_USER=vulnforge_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Assembled by config.py — do not set manually unless overriding
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_URL=redis://:password@host:port/db

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=3900
CELERY_MAX_RETRIES=3

# ── Plugin System ─────────────────────────────────────────────────────────────
PLUGIN_EXECUTION_TIMEOUT=300
PLUGIN_MAX_CONCURRENT_SCANS=5
PLUGIN_SANDBOX_ENABLED=true
PLUGIN_OUTPUT_DIR=/tmp/vulnforge/plugin_output

# ── Report Engine ─────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=/tmp/vulnforge/reports
REPORT_MAX_AGE_DAYS=90

# ── External Tools ────────────────────────────────────────────────────────────
NMAP_BINARY=/usr/bin/nmap
NUCLEI_BINARY=/usr/local/bin/nuclei
NIKTO_BINARY=/usr/bin/nikto
GOBUSTER_BINARY=/usr/local/bin/gobuster
METASPLOIT_RPC_HOST=localhost
METASPLOIT_RPC_PORT=55553
METASPLOIT_RPC_PASSWORD=CHANGE_ME

# ── Shodan (optional) ─────────────────────────────────────────────────────────
SHODAN_API_KEY=

# ── CORS & Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── First Superuser (seeded on first run) ─────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@vulnforge.local
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
FIRST_SUPERUSER_USERNAME=admin
